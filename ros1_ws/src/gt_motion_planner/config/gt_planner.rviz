Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Color: 160; 160; 164
      Plane Cell Count: 14
      Cell Size: 1
    - Class: rviz/MarkerArray
      Name: GT Trajectories
      Enabled: true
      Marker Topic: /gt_planner/markers
      Queue Size: 100
    - Class: rviz/LaserScan
      Name: Lidar
      Enabled: true
      Topic: /scan
      Size (m): 0.04
      Style: Points
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Decay Time: 0
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.6
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 18
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.2
      Yaw: 0.78
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
