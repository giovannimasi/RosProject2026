<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0 0 12 0 1.5708 1.5708</pose>
        <view_controller>orbit</view_controller>
        <projection_type>orthographic</projection_type>
      </camera>
    </gui>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Ostacoli statici (devono combaciare con static_obstacles nel yaml) -->
    <model name="obs_box_1">
      <static>true</static>
      <pose>1.5 0.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obs_pole_1">
      <static>true</static>
      <pose>-1.5 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.3 0.5 1</ambient><diffuse>0.3 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obs_pole_2">
      <static>true</static>
      <pose>-1.5 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.3 0.5 1</ambient><diffuse>0.3 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
