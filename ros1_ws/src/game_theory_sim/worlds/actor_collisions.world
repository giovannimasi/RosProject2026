<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <!-- Z=10 (altezza), Pitch=1.5708 (90 gradi in basso) -->
        <pose>0 0 10 0 1.5708 1.5708</pose>
        <view_controller>orbit</view_controller>
        <projection_type>orthographic</projection_type>
      </camera>
    </gui>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Actor 1 -->
    <actor name="actor">
      <pose>-6 -6 0 0 0 0</pose>
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>false</interpolate_x>
      </animation>
      <plugin name="actor_collisions_plugin" filename="libactor_collisions_plugin.so">
        <scaling collision="L-Thigh_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="R-Thigh_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="L-Calf_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="R-Calf_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="Neck_Collider" scale="12.0 12.0 12.0"/>
      </plugin>
      <plugin name="random_smooth_actor_plugin" filename="librandom_smooth_actor_plugin.so">
        <min_x>-8.0</min_x>
        <max_x>8.0</max_x>
        <min_y>-8.0</min_y>
	<max_y>8.0</max_y>

	<roll_offset>1.5708</roll_offset>
	<pitch_offset>0</pitch_offset>
        <yaw_offset>1.5780</yaw_offset>
        <z_offset>1.0</z_offset>

        <min_speed>0.45</min_speed>
        <max_speed>0.75</max_speed>
        <max_turn_rate>0.45</max_turn_rate>
        <target_tolerance>0.7</target_tolerance>
        <animation_factor>4.5</animation_factor>

        <seed>101</seed>
      </plugin>
    </actor>

    <!-- Actor 2 -->
    <actor name="actor_2">
      <pose>6 6 0 0 0 3.14</pose>
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <scale>1.0</scale>
	<interpolate_x>false</interpolate_x>
      </animation>
      <plugin name="actor_collisions_plugin" filename="libactor_collisions_plugin.so">
        <scaling collision="L-Thigh_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="R-Thigh_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="L-Calf_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="R-Calf_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="Neck_Collider" scale="12.0 12.0 12.0"/>
      </plugin>
      <plugin name="random_smooth_actor_plugin_2" filename="librandom_smooth_actor_plugin.so">
        <min_x>-8.0</min_x>
        <max_x>8.0</max_x>
        <min_y>-8.0</min_y>
        <max_y>8.0</max_y>

	<roll_offset>1.5708</roll_offset>
	<pitch_offset>0</pitch_offset>
        <yaw_offset>1.5780</yaw_offset>
        <z_offset>1.0</z_offset>

        <min_speed>0.45</min_speed>
        <max_speed>0.75</max_speed>
        <max_turn_rate>0.45</max_turn_rate>
        <target_tolerance>0.7</target_tolerance>
        <animation_factor>4.5</animation_factor>

        <seed>202</seed>
      </plugin>
    </actor>

    <!-- Actor 3 (group L) -->
    <actor name="actor_3_group_L">
      <pose>-0.45 6.0 0 0 0 -1.57</pose>
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking">
        <filename>walk.dae</filename><scale>1.0</scale>
        <interpolate_x>false</interpolate_x>
      </animation>
      <plugin name="actor_collisions_plugin_3" filename="libactor_collisions_plugin.so">
        <scaling collision="L-Thigh_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="R-Thigh_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="L-Calf_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="R-Calf_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="Neck_Collider" scale="12.0 12.0 12.0"/>
      </plugin>
      <plugin name="random_group_actor_L" filename="librandom_smooth_actor_plugin.so">
        <min_x>-7.0</min_x>
        <max_x>7.0</max_x>
        <min_y>-7.0</min_y>
	<max_y>7.0</max_y>

	<roll_offset>1.5708</roll_offset>
	<pitch_offset>0</pitch_offset>
        <yaw_offset>1.5780</yaw_offset>
        <z_offset>1.0</z_offset>

        <min_speed>0.55</min_speed>
        <max_speed>0.65</max_speed>
        <max_turn_rate>0.35</max_turn_rate>
        <target_tolerance>0.8</target_tolerance>
        <animation_factor>4.5</animation_factor>

        <use_center_pose>true</use_center_pose>
        <center_x>0.0</center_x>
        <center_y>6.0</center_y>
        <center_yaw>-1.57</center_yaw>

        <lateral_offset>-0.45</lateral_offset>
        <seed>303</seed>
      </plugin>
    </actor>

    <!-- Actor 4 (group R) -->
    <actor name="actor_4_group_R">
      <pose>0.45 6.0 0 0 0 -1.57</pose>
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking">
	      <filename>walk.dae</filename><scale>1.0</scale>
	      <interpolate_x>false</interpolate_x>
      </animation>
      <plugin name="actor_collisions_plugin_4" filename="libactor_collisions_plugin.so">
        <scaling collision="L-Thigh_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="R-Thigh_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="L-Calf_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="R-Calf_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="Neck_Collider" scale="12.0 12.0 12.0"/>
      </plugin>
      <plugin name="random_group_actor_R" filename="librandom_smooth_actor_plugin.so">
        <min_x>-7.0</min_x>
        <max_x>7.0</max_x>
        <min_y>-7.0</min_y>
        <max_y>7.0</max_y>

	<roll_offset>1.5708</roll_offset>
	<pitch_offset>0</pitch_offset>
        <yaw_offset>1.5780</yaw_offset>
        <z_offset>1.0</z_offset>

        <min_speed>0.55</min_speed>
        <max_speed>0.65</max_speed>
        <max_turn_rate>0.35</max_turn_rate>
        <target_tolerance>0.8</target_tolerance>
        <animation_factor>4.5</animation_factor>

        <use_center_pose>true</use_center_pose>
        <center_x>0.0</center_x>
        <center_y>6.0</center_y>
        <center_yaw>-1.57</center_yaw>

        <lateral_offset>0.45</lateral_offset>
        <seed>303</seed>
      </plugin>
    </actor>
  </world>
</sdf>
