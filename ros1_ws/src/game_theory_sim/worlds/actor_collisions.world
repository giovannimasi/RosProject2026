<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <!-- Z=10 (altezza), Pitch=1.5708 (90 gradi in basso) -->
        <pose>0 0 10 0 1.5708 1.5708</pose>
        <view_controller>orbit</view_controller>
        <projection_type>orthographic</projection_type>
      </camera>
    </gui>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Actor 1 -->
    <actor name="actor">
      <pose>-6 -6 0 0 0 0</pose>
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>false</interpolate_x>
      </animation>
      <plugin name="actor_collisions_plugin" filename="libactor_collisions_plugin.so">
        <scaling collision="L-Thigh_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="R-Thigh_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="L-Calf_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="R-Calf_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="Neck_Collider" scale="12.0 12.0 12.0"/>
      </plugin>
<plugin name="random_smooth_actor_plugin" filename="librandom_smooth_actor_plugin.so">
  <min_x>-4.0</min_x>
  <max_x>4.0</max_x>
  <min_y>-4.0</min_y>
  <max_y>4.0</max_y>

  <min_speed>0.18</min_speed>
  <max_speed>0.26</max_speed>
  <max_turn_rate>0.35</max_turn_rate>

  <min_straight_time>4.0</min_straight_time>
  <max_straight_time>9.0</max_straight_time>
  <min_turn_angle>-1.2</min_turn_angle>
  <max_turn_angle>1.2</max_turn_angle>

  <wall_margin>1.0</wall_margin>
  <look_ahead_distance>1.5</look_ahead_distance>

  <avoidance_radius>1.4</avoidance_radius>
  <hard_avoidance_radius>0.65</hard_avoidance_radius>
  <avoidance_gain>1.0</avoidance_gain>

  <avoid_model>actor_2</avoid_model>
  <avoid_model>actor_3_group_L</avoid_model>
  <avoid_model>actor_4_group_R</avoid_model>

  <heading_noise_amplitude>0.025</heading_noise_amplitude>
  <heading_noise_frequency>0.5</heading_noise_frequency>

  <roll_offset>1.5708</roll_offset>
  <pitch_offset>0.0</pitch_offset>
  <yaw_offset>1.5780</yaw_offset>
  <z_offset>1.0</z_offset>

  <seed>101</seed>
</plugin>
    </actor>

    <!-- Actor 2 -->
    <actor name="actor_2">
      <pose>6 6 0 0 0 3.14</pose>
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <scale>1.0</scale>
	<interpolate_x>false</interpolate_x>
      </animation>
      <plugin name="actor_collisions_plugin" filename="libactor_collisions_plugin.so">
        <scaling collision="L-Thigh_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="R-Thigh_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="L-Calf_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="R-Calf_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="Neck_Collider" scale="12.0 12.0 12.0"/>
      </plugin>
<plugin name="random_smooth_actor_plugin" filename="librandom_smooth_actor_plugin.so">
  <min_x>-4.0</min_x>
  <max_x>4.0</max_x>
  <min_y>-4.0</min_y>
  <max_y>4.0</max_y>

  <min_speed>0.18</min_speed>
  <max_speed>0.26</max_speed>
  <max_turn_rate>0.35</max_turn_rate>

  <min_straight_time>4.0</min_straight_time>
  <max_straight_time>9.0</max_straight_time>
  <min_turn_angle>-1.2</min_turn_angle>
  <max_turn_angle>1.2</max_turn_angle>

  <wall_margin>1.0</wall_margin>
  <look_ahead_distance>1.5</look_ahead_distance>

  <avoidance_radius>1.4</avoidance_radius>
  <hard_avoidance_radius>0.65</hard_avoidance_radius>
  <avoidance_gain>1.0</avoidance_gain>

<avoid_model>actor</avoid_model>
<avoid_model>actor_3_group_L</avoid_model>
<avoid_model>actor_4_group_R</avoid_model>

  <heading_noise_amplitude>0.025</heading_noise_amplitude>
  <heading_noise_frequency>0.5</heading_noise_frequency>

  <roll_offset>1.5708</roll_offset>
  <pitch_offset>0.0</pitch_offset>
  <yaw_offset>1.5780</yaw_offset>
  <z_offset>1.0</z_offset>

  <seed>202</seed>
</plugin>
    </actor>

    <!-- Actor 3 (group L) -->
    <actor name="actor_3_group_L">
      <pose>-0.45 6.0 0 0 0 -1.57</pose>
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking">
        <filename>walk.dae</filename><scale>1.0</scale>
        <interpolate_x>false</interpolate_x>
      </animation>
      <plugin name="actor_collisions_plugin_3" filename="libactor_collisions_plugin.so">
        <scaling collision="L-Thigh_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="R-Thigh_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="L-Calf_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="R-Calf_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="Neck_Collider" scale="12.0 12.0 12.0"/>
      </plugin>
<plugin name="random_group_actor_L" filename="librandom_smooth_actor_plugin.so">
  <min_x>-3.5</min_x>
  <max_x>3.5</max_x>
  <min_y>-3.5</min_y>
  <max_y>3.5</max_y>

  <min_speed>0.18</min_speed>
  <max_speed>0.26</max_speed>
  <max_turn_rate>0.28</max_turn_rate>

  <min_straight_time>5.0</min_straight_time>
  <max_straight_time>10.0</max_straight_time>
  <min_turn_angle>-1.0</min_turn_angle>
  <max_turn_angle>1.0</max_turn_angle>

  <wall_margin>1.2</wall_margin>
  <look_ahead_distance>1.5</look_ahead_distance>

  <avoidance_radius>1.4</avoidance_radius>
  <hard_avoidance_radius>0.65</hard_avoidance_radius>
  <avoidance_gain>1.0</avoidance_gain>

  <avoid_model>actor</avoid_model>
  <avoid_model>actor_2</avoid_model>

  <use_center_pose>true</use_center_pose>
  <center_x>0.0</center_x>
  <center_y>3.0</center_y>
  <center_yaw>-1.57</center_yaw>

  <lateral_offset>-0.45</lateral_offset>

  <heading_noise_amplitude>0.015</heading_noise_amplitude>
  <heading_noise_frequency>0.4</heading_noise_frequency>

  <roll_offset>1.5708</roll_offset>
  <pitch_offset>0.0</pitch_offset>
  <yaw_offset>1.5780</yaw_offset>
  <z_offset>1.0</z_offset>

  <seed>303</seed>
</plugin>
</actor>

    <!-- Actor 4 (group R) -->
    <actor name="actor_4_group_R">
      <pose>0.45 6.0 0 0 0 -1.57</pose>
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walking">
	      <filename>walk.dae</filename><scale>1.0</scale>
	      <interpolate_x>false</interpolate_x>
      </animation>
      <plugin name="actor_collisions_plugin_4" filename="libactor_collisions_plugin.so">
        <scaling collision="L-Thigh_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="R-Thigh_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="L-Calf_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="R-Calf_Collider" scale="12.0 12.0 12.0"/>
        <scaling collision="Neck_Collider" scale="12.0 12.0 12.0"/>
      </plugin>
<plugin name="random_group_actor_R" filename="librandom_smooth_actor_plugin.so">
  <min_x>-3.5</min_x>
  <max_x>3.5</max_x>
  <min_y>-3.5</min_y>
  <max_y>3.5</max_y>

  <min_speed>0.18</min_speed>
  <max_speed>0.26</max_speed>
  <max_turn_rate>0.28</max_turn_rate>

  <min_straight_time>5.0</min_straight_time>
  <max_straight_time>10.0</max_straight_time>
  <min_turn_angle>-1.0</min_turn_angle>
  <max_turn_angle>1.0</max_turn_angle>

  <wall_margin>1.2</wall_margin>
  <look_ahead_distance>1.5</look_ahead_distance>

  <avoidance_radius>1.4</avoidance_radius>
  <hard_avoidance_radius>0.65</hard_avoidance_radius>
  <avoidance_gain>1.0</avoidance_gain>

  <avoid_model>actor</avoid_model>
  <avoid_model>actor_2</avoid_model>

  <use_center_pose>true</use_center_pose>
  <center_x>0.0</center_x>
  <center_y>3.0</center_y>
  <center_yaw>-1.57</center_yaw>

  <lateral_offset>0.45</lateral_offset>

  <heading_noise_amplitude>0.015</heading_noise_amplitude>
  <heading_noise_frequency>0.4</heading_noise_frequency>

  <roll_offset>1.5708</roll_offset>
  <pitch_offset>0.0</pitch_offset>
  <yaw_offset>1.5780</yaw_offset>
  <z_offset>1.0</z_offset>

  <seed>303</seed>
</plugin>
</actor>

    <!-- ====================================================================
         Ostacoli statici (X^obj). Devono combaciare con la lista
         static_obstacles in gt_planner.yaml (il planner li evita nel
         validity checker dell'RRT). Interni, lontani dai goal.
         ==================================================================== -->

    <!-- Box centrale -->
    <model name="obs_box_1">
      <static>true</static>
      <pose>1.5 0.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Muro (parallelepipedo lungo in y) -->
    <model name="obs_wall_1">
      <static>true</static>
      <pose>-1.5 1.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 2.0 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 2.0 0.8</size></box></geometry>
          <material><ambient>0.45 0.4 0.35 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Palo 1 -->
    <model name="obs_pole_1">
      <static>true</static>
      <pose>-1.0 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.3 0.5 1</ambient><diffuse>0.3 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Palo 2 -->
    <model name="obs_pole_2">
      <static>true</static>
      <pose>1.5 -2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.3 0.5 1</ambient><diffuse>0.3 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
